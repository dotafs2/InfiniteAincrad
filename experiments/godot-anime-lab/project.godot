; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Anime Material Lab"
config/description="Per-surface toon lighting + optional restrained depth-outline post. Shared shader/include style constants."
run/main_scene="res://scenes/material_lab.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[dotnet]

project/assembly_name="Godot Anime Material Lab"

[editor_plugins]

enabled=PackedStringArray("res://addons/lab_boot/plugin.cfg")

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1
