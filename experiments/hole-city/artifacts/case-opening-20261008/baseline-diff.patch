+	var price:Variant=value.get("price")
+	var seed_value:Variant=value.get("presentation_seed")
+	if not serial is int or serial<=0:return {}
+	if not case_id is String or case_id!="skin-case-%d"%serial:return {}
+	if not id is String or not skin_unlocked(id):return {}
+	if not rarity is String or Rarity.index_of(rarity)<0:return {}
+	if not price is int or price!=COIN_DRAW_PRICE:return {}
+	if not seed_value is int or seed_value<0 or seed_value>2147483647:return {}
+	var raw_odds:Variant=value.get("odds")
+	if not raw_odds is Dictionary:return {}
+	var raw_entries:Variant=raw_odds.get("entries")
+	if not raw_entries is Array or raw_entries.size()!=Rarity.ORDER.size():return {}
+	var entries:Array[Dictionary]=[]
+	var total:=0
+	var total_count:=0
+	var winning_tier_present:=false
+	for index in Rarity.ORDER.size():
+		var entry:Variant=raw_entries[index]
+		if not entry is Dictionary or entry.get("rarity")!=Rarity.ORDER[index]:return {}
+		var count:Variant=entry.get("count")
+		var weight:Variant=entry.get("weight")
+		if not count is int or count<0 or count>SKIN_DEFS.size():return {}
+		if not weight is int or weight<0 or weight>10000 or count==0 and weight!=0:return {}
+		total+=int(weight);total_count+=int(count)
+		if entry.rarity==rarity:winning_tier_present=count>0 and weight>0
+		entries.append({"rarity":Rarity.ORDER[index],"weight":int(weight),"count":int(count),"chance":0.0})
+	if total<=0 or total_count>SKIN_DEFS.size() or not winning_tier_present:return {}
+	if not raw_odds.get("total_weight") is int or raw_odds.total_weight!=total:return {}
+	var guarantee:Variant=raw_odds.get("guarantee","")
+	var counters:Variant=raw_odds.get("counters")
+	if not guarantee is String or (not guarantee.is_empty() and not SkinDraw.GUARANTEES.has(guarantee)):return {}
+	if not counters is Dictionary:return {}
+	for tier in SkinDraw.GUARANTEES:
+		if not counters.get(tier) is int:return {}
+	for entry:Dictionary in entries:entry.chance=float(entry.weight)/float(total)
+	return {"schema":1,"serial":int(serial),"case_id":str(case_id),"id":str(id),"rarity":str(rarity),"price":int(price),"presentation_seed":int(seed_value),
+		"odds":{"entries":entries,"total_weight":total,"guarantee":str(guarantee),"counters":SkinDraw.clean_counters(counters)}}
