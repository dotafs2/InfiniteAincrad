+func _clean_skin_case_receipt(value:Variant)->Dictionary:
+	# A receipt describes an already-owned award. It is never an entitlement,
+	# a debit instruction, or a reason to reroll after cold restore.
+	if not value is Dictionary or value.get("schema")!=1:return {}
+	var serial:Variant=value.get("serial")
