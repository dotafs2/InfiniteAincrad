+func remember_rain_support(collider:Object)->void:
+	if not collider is CollisionObject3D:
+		rain_support=null
+		return
+	if rain_support==null or rain_support.get_ref()!=collider:rain_support=weakref(collider)
+	rain_support_transform=collider.global_transform
+
+func wake_after_rain_support_change()->void:
+	if not sleeping or not rain_landed or rain_support==null:return
+	var support=rain_support.get_ref()
+	# Swept support may settle slightly above a collider and native sleeping
+	# contacts do not reliably wake after removal. Track the actual ray owner,
+	# not a height plane. Existing rain physics callbacks need no extra rays.
+	if is_instance_valid(support) and support.is_inside_tree() and not support.is_queued_for_deletion():
+		if (support.collision_layer&collision_mask)!=0 and support.global_transform.is_equal_approx(rain_support_transform):return
+	rain_support=null
+	rain_landed=false;rain_contact_time=0.0;sleeping=false
+	# Remove the cached pose immediately. Gravity moves the original body;
+	# no new body, teleport, score, artificial freeze or support is introduced.
+	expose_visual()
+
