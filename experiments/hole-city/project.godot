; Standalone GDScript game. No accounts, providers or town saves.
config_version=5

[application]
config/name="Hole Feast"
config/version="0.13.0"
; Preserve the original storage identity when changing the display name.
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/SinkCity"
config/custom_user_dir_name.macos="Godot/app_userdata/SinkCity"
config/custom_user_dir_name.windows="Godot/app_userdata/SinkCity"
run/main_scene="res://fidelity/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/size/min_width=270
window/size/min_height=480
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.63,0.79,0.81,1)

[physics]
3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60
3d/default_gravity=18.0

[audio]
driver/enable_input=false
general/ios/session_category=3
general/ios/mix_with_others=true
buses/default_bus_layout="res://fidelity/audio_bus_layout.tres"

[shader_globals]
hole_reveal_target={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
hole_reveal_camera={
"type": "vec4",
"value": Vector4(0, 18, 14, 0)
}
hole_reveal_aperture={
"type": "vec4",
"value": Vector4(1.85, 0.65, 0, 0)
}
hole_reveal_back={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
