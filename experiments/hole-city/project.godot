; Standalone GDScript game. No accounts, providers or town saves.
config_version=5

[application]
config/name="Sink City"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=800
window/size/min_height=500
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.63,0.79,0.81,1)

[physics]
3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60
3d/default_gravity=18.0

[audio]
driver/enable_input=false
