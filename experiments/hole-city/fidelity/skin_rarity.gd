static func index_of(id:String)->int:
	return ORDER.find(id)

static func data(id:String)->Dictionary:
	var index:=index_of(id)
	if index<0:return {}
	return {"id":id,"name":NAMES[index],"color":COLORS[index],"rank":index,"base_weight":BASE_WEIGHTS[index],"profile":PROFILES[index]}

static func for_skin(skin_id:String)->String:
	return str(SKIN_TIERS.get(skin_id,""))
